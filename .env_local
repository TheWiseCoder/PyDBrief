# baseline
FLASK_APP=app_main.py
PYPOMES_APP_PREFIX=PYDB
PYDB_LOG_SQLALCHEMY=0
TZ=America/Sao_Paulo

# migration activities state control (database - pool is not used)
PYDB_DB_ENGINES="dbctrl"
PYDB_DBCTRL_TYPE="postgres"
PYDB_DBCTRL_NAME="pydbrief"
PYDB_DBCTRL_USER="pydbrief_s"
PYDB_DBCTRL_PWD="4d4c39cad7d0686204fcfebc8c11f8db"
PYDB_DBCTRL_HOST="172.16.5.34"
PYDB_DBCTRL_PORT=9005

# migration activities state control (cloud storage)
PYDB_CS_ENGINES="csctrl"
PYDB_CSCTRL_ENGINE_TYPE="aws"
PYDB_CSCTRL_BUCKET_NAME="bkt-global-aje-prd"
PYDB_CSCTRL_ACCESS_KEY="AKIA64BE8489DACD75D0"
PYDB_CSCTRL_SECRET_KEY="1vMMFin0OfBfLvev0xYdc/l8sIrMHRlzkr5KyLIa"
PYDB_CSCTRL_ENDPOINT_URL="http://ecsprd.trf1.jus.br:9020"
PYDB_CSCTRL_SECURE_ACCESS=0
